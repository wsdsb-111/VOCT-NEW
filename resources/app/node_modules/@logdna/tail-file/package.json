{
  "name": "@logdna/tail-file",
  "version": "4.0.2",
  "description": "A node.js version of unix's `tail -f` command",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "lib/**",
    "index.js",
    "index.d.ts",
    "*.md",
    "LICENSE"
  ],
  "engineStrict": true,
  "engines": {
    "node": ">= 18"
  },
  "private": false,
  "release": {
    "extends": "semantic-release-config-logdna",
    "branches": [
      "main"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/logdna/tail-file-node"
  },
  "homepage": "https://github.com/logdna/tail-file-node",
  "author": {
    "name": "Darin Spivey",
    "email": "darin.spivey@mezmo.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@logdna/commitlint-config": "^2.0.0",
    "eslint": "^8.18.0",
    "eslint-config-logdna": "^7.0.0",
    "semantic-release": "^17.4.7",
    "semantic-release-config-logdna": "^1.3.0",
    "tap": "^16.3.4",
    "tap-xunit": "^2.4.1"
  },
  "tap": {
    "100": true,
    "ts": false,
    "jsx": false,
    "check-coverage": true,
    "jobs": 1,
    "timeout": 60,
    "coverage-report": [
      "text",
      "text-summary",
      "json",
      "json-summary",
      "html"
    ],
    "reporter": "tap",
    "nyc-arg": [
      "--exclude=test/",
      "--exclude=tools",
      "--all"
    ],
    "files": [
      "test/**/*.js"
    ],
    "output-file": "coverage/.tap-output"
  },
  "commitlint": {
    "extends": [
      "@logdna/commitlint-config"
    ]
  }
}